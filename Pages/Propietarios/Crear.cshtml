@page
@model HipodromoNacional.Pages.Propietarios.CrearModel
@{
    ViewData["Title"] = "Crear Propietario";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Registrar Nuevo Propietario</h4>
    </div>
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <h5 class="text-secondary border-bottom pb-2">Datos Personales</h5>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Cédula</label>
                    <input asp-for="Propietario.Cedula" class="form-control" required />
                    <span asp-validation-for="Propietario.Cedula" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Propietario.Nombre" class="form-control" required />
                    <span asp-validation-for="Propietario.Nombre" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Primer Apellido</label>
                    <input asp-for="Propietario.Apellido1" class="form-control" required />
                    <span asp-validation-for="Propietario.Apellido1" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Segundo Apellido</label>
                    <input asp-for="Propietario.Apellido2" class="form-control" />
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4">Dirección Anidada</h5>
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="form-label">País</label>
                    <select id="ddlPais" class="form-select" required>
                        <option value="">Seleccione...</option>
                        @foreach (var pais in Model.Paises)
                        {
                            <option value="@pais.id">@pais.nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Provincia</label>
                    <select id="ddlProvincia" class="form-select" required disabled>
                        <option value="">Seleccione...</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantón</label>
                    <select id="ddlCanton" class="form-select" required disabled>
                        <option value="">Seleccione...</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Distrito</label>
                    <select id="ddlDistrito" class="form-select" required disabled>
                        <option value="">Seleccione...</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Barrio</label>
                    <select id="ddlBarrio" name="Propietario.IdBarrio" class="form-select" required disabled>
                        <option value="">Seleccione...</option>
                    </select>
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4">Información de Contacto</h5>
            
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label d-flex justify-content-between">
                        Teléfonos <button type="button" class="btn btn-sm btn-outline-success" onclick="addTelefono()">+ Agregar</button>
                    </label>
                    <div id="telefonosContainer">
                        <div class="input-group mb-2">
                            <input type="text" name="Telefonos" class="form-control" placeholder="Número" required />
                            <select name="TiposTelefonos" class="form-select" required>
                                <option value="Personal">Personal</option>
                                <option value="Trabajo">Trabajo</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label d-flex justify-content-between">
                        Correos <button type="button" class="btn btn-sm btn-outline-success" onclick="addCorreo()">+ Agregar</button>
                    </label>
                    <div id="correosContainer">
                        <div class="input-group mb-2">
                            <input type="email" name="Correos" class="form-control" placeholder="Correo" required />
                            <select name="TiposCorreos" class="form-select" required>
                                <option value="Personal">Personal</option>
                                <option value="Trabajo">Trabajo</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" asp-for="Propietario.Estado" value="Activo" />
            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Propietario</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
    function addTelefono() {
        const template = `
            <div class="input-group mb-2">
                <input type="text" name="Telefonos" class="form-control" placeholder="Número" required />
                <select name="TiposTelefonos" class="form-select" required>
                    <option value="Personal">Personal</option><option value="Trabajo">Trabajo</option><option value="Otro">Otro</option>
                </select>
                <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">X</button>
            </div>`;
        document.getElementById('telefonosContainer').insertAdjacentHTML('beforeend', template);
    }

    function addCorreo() {
        const template = `
            <div class="input-group mb-2">
                <input type="email" name="Correos" class="form-control" placeholder="Correo" required />
                <select name="TiposCorreos" class="form-select" required>
                    <option value="Personal">Personal</option><option value="Trabajo">Trabajo</option><option value="Otro">Otro</option>
                </select>
                <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">X</button>
            </div>`;
        document.getElementById('correosContainer').insertAdjacentHTML('beforeend', template);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const ddlPais = document.getElementById("ddlPais");
        const ddlProvincia = document.getElementById("ddlProvincia");
        const ddlCanton = document.getElementById("ddlCanton");
        const ddlDistrito = document.getElementById("ddlDistrito");
        const ddlBarrio = document.getElementById("ddlBarrio");

        function clearAndDisable(selects) {
            selects.forEach(sel => {
                sel.innerHTML = '<option value="">Seleccione...</option>';
                sel.disabled = true;
            });
        }

        ddlPais.addEventListener("change", async function () {
            const paisId = this.value;
            clearAndDisable([ddlProvincia, ddlCanton, ddlDistrito, ddlBarrio]);
            if (!paisId) return;

            try {
                const response = await fetch(`?handler=Provincias&paisId=${paisId}`);
                const data = await response.json();
                
                ddlProvincia.disabled = false;
                data.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.id;
                    opt.textContent = item.nombre;
                    ddlProvincia.appendChild(opt);
                });
            } catch (err) {
                console.error("Error cargando provincias:", err);
            }
        });

        ddlProvincia.addEventListener("change", async function () {
            const provId = this.value;
            clearAndDisable([ddlCanton, ddlDistrito, ddlBarrio]);
            if (!provId) return;

            try {
                const response = await fetch(`?handler=Cantones&provinciaId=${provId}`);
                const data = await response.json();
                
                ddlCanton.disabled = false;
                data.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.id;
                    opt.textContent = item.nombre;
                    ddlCanton.appendChild(opt);
                });
            } catch (err) {
                console.error("Error cargando cantones:", err);
            }
        });

        ddlCanton.addEventListener("change", async function () {
            const cantonId = this.value;
            clearAndDisable([ddlDistrito, ddlBarrio]);
            if (!cantonId) return;

            try {
                const response = await fetch(`?handler=Distritos&cantonId=${cantonId}`);
                const data = await response.json();
                
                ddlDistrito.disabled = false;
                data.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.id;
                    opt.textContent = item.nombre;
                    ddlDistrito.appendChild(opt);
                });
            } catch (err) {
                console.error("Error cargando distritos:", err);
            }
        });

        ddlDistrito.addEventListener("change", async function () {
            const distrId = this.value;
            clearAndDisable([ddlBarrio]);

            if (!distrId) return;

            try {
                const response = await fetch(`?handler=Barrios&distritoId=${distrId}`);
                const data = await response.json();
                
                ddlBarrio.disabled = false;
                
                // Add default option
                const defaultOpt = document.createElement("option");
                defaultOpt.value = "";
                defaultOpt.textContent = "Seleccione...";
                ddlBarrio.appendChild(defaultOpt);

                data.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.id;
                    opt.textContent = item.nombre;
                    ddlBarrio.appendChild(opt);
                });
            } catch (err) {
                console.error("Error cargando barrios:", err);
            }
        });
    });
</script>
}
