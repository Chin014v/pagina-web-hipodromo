@page "{id:int}"
@model HipodromoNacional.Pages.Propietarios.EliminarModel
@{
    ViewData["Title"] = "Eliminar Propietario";
}

<div class="card shadow-sm mt-4 border-danger">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación</h4>
    </div>
    <div class="card-body text-center py-5">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-start">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <h5 class="text-danger">¿Estás seguro que deseas eliminar permanentemente a este propietario?</h5>
        <h3 class="mt-3">@Model.Propietario.Nombre @Model.Propietario.Apellido1</h3>
        <p class="text-muted">Cédula: @Model.Propietario.Cedula</p>
        
        <div class="alert alert-danger mt-4 text-start d-inline-block">
            <strong>Advertencia:</strong> Esta acción eliminará al propietario y no se podrá deshacer.
        </div>

        <form method="post" class="mt-4">
            <input type="hidden" asp-for="Propietario.IdPropietario" />
            <button type="submit" class="btn btn-danger btn-lg"><i class="bi bi-trash"></i> Sí, Eliminar</button>
            <a asp-page="./Index" class="btn btn-secondary btn-lg ms-2">Cancelar</a>
        </form>
    </div>
</div>
