@page
@model HipodromoNacional.Pages.Veterinaria.IndexModel
@{
    ViewData["Title"] = "Historial Veterinario";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-heart-pulse"></i> Historial Veterinario</h2>
    </div>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Registro Veterinario</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Caballo</th>
                <th>Veterinario</th>
                <th>Diagnóstico</th>
                <th>Fecha Revisión</th>
                <th>Vence Cert.</th>
                <th>Vigente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Historiales)
            {
                <tr>
                    <td><code>@item.CodigoRegistro</code></td>
                    <td>@item.NombreCaballo</td>
                    <td>@item.NombreVeterinario</td>
                    <td>@item.Diagnostico</td>
                    <td>@item.FechaRevision.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaVencimientoCertificado.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.CertificadoVigente)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Vigente</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Vencido</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@item.IdHistorial" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@item.IdHistorial" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
