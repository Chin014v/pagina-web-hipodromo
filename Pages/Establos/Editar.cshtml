@page "{id:int}"
@model HipodromoNacional.Pages.Establos.EditarModel
@{
    ViewData["Title"] = "Editar Establo";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Establo</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="alert alert-info">
            Según las reglas del proyecto (Punto 7), modificaremos al menos 3 campos: <strong>Ubicación, Capacidad y Estado</strong>.
        </div>

        <form method="post" novalidate>
            <input type="hidden" asp-for="Establo.IdEstablo" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Ubicación</label>
                <input asp-for="Establo.Ubicacion" class="form-control" required />
                <span asp-validation-for="Establo.Ubicacion" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Capacidad</label>
                <input asp-for="Establo.Capacidad" type="number" min="1" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Establo.Capacidad" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select asp-for="Establo.Estado" class="form-select" required>
                    <option value="Disponible">Disponible</option>
                    <option value="Lleno">Lleno</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                </select>
                <span asp-validation-for="Establo.Estado" class="field-validation-error"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
