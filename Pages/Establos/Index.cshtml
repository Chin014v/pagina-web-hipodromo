@page
@model HipodromoNacional.Pages.Establos.IndexModel
@{
    ViewData["Title"] = "Listado de Establos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-house-door-fill"></i> Establos Registrados</h2>
    </div>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Establo</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Código</th>
                <th>Ubicación</th>
                <th>Capacidad (Caballos)</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Establos)
            {
                <tr>
                    <td>@e.IdEstablo</td>
                    <td>@e.Codigo</td>
                    <td>@e.Ubicacion</td>
                    <td>@e.Capacidad</td>
                    <td>
                        @if (e.Estado == "Disponible")
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else if (e.Estado == "Lleno")
                        {
                            <span class="badge bg-danger">Lleno</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">En Mantenimiento</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@e.IdEstablo" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@e.IdEstablo" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
