@page
@model HipodromoNacional.Pages.Eventos.CrearModel
@{
    ViewData["Title"] = "Programar Evento";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Programar Nuevo Evento</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Código Evento</label>
                    <input asp-for="Evento.CodigoEvento" class="form-control" required />
                    <span asp-validation-for="Evento.CodigoEvento" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre de Carrera</label>
                    <input asp-for="Evento.Nombre" class="form-control" required />
                    <span asp-validation-for="Evento.Nombre" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha y Hora</label>
                    <input asp-for="Evento.Fecha" type="datetime-local" class="form-control" step="any" required data-val-date="Ingrese una fecha válida." />
                    <span asp-validation-for="Evento.Fecha" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Tipo de Carrera</label>
                    <select asp-for="Evento.TipoCarrera" class="form-select" required>
                        <option value="Plana">Plana</option>
                        <option value="Con Obstáculos">Con Obstáculos</option>
                        <option value="Trote">Trote</option>
                    </select>
                    <span asp-validation-for="Evento.TipoCarrera" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Distancia (Metros)</label>
                    <input asp-for="Evento.DistanciaMetros" type="number" step="0.01" min="1" class="form-control" required data-val-number="Ingrese un número válido." />
                    <span asp-validation-for="Evento.DistanciaMetros" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Premio Total ($)</label>
                    <input asp-for="Evento.PremioTotal" type="number" step="0.01" min="0.01" class="form-control" required data-val-number="Ingrese un número válido." />
                    <span asp-validation-for="Evento.PremioTotal" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Precio Inscripción ($)</label>
                    <input asp-for="Evento.PrecioInscripcion" type="number" step="0.01" min="0.01" class="form-control" required data-val-number="Ingrese un número válido." />
                    <span asp-validation-for="Evento.PrecioInscripcion" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Estado</label>
                    <select asp-for="Evento.Estado" class="form-select" required>
                        <option value="Programado">Programado</option>
                        <option value="EnCurso">En Curso</option>
                        <option value="Finalizado">Finalizado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                    <span asp-validation-for="Evento.Estado" class="field-validation-error"></span>
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Evento</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
