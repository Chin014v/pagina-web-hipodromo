@page
@model HipodromoNacional.Pages.Eventos.IndexModel
@{
    ViewData["Title"] = "Listado de Eventos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-calendar-event"></i> Eventos / Carreras Registradas</h2>
    </div>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Programar Evento</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Distancia</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Eventos)
            {
                <tr>
                    <td>@e.CodigoEvento</td>
                    <td>@e.Nombre</td>
                    <td>@e.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@e.TipoCarrera</td>
                    <td>@e.DistanciaMetros m</td>
                    <td>
                        @if (e.Estado == "Programado")
                        {
                            <span class="badge bg-info text-dark">Programado</span>
                        }
                        else if (e.Estado == "EnCurso")
                        {
                            <span class="badge bg-warning text-dark">En Curso</span>
                        }
                        else if (e.Estado == "Finalizado")
                        {
                            <span class="badge bg-success">Finalizado</span>
                        }
                        else if (e.Estado == "Cancelado")
                        {
                            <span class="badge bg-danger">Cancelado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@e.Estado</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@e.IdEvento" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@e.IdEvento" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
