@page "{id:int}"
@model HipodromoNacional.Pages.Eventos.EditarModel
@{
    ViewData["Title"] = "Editar Evento";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Evento</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form method="post" novalidate>
            <input type="hidden" asp-for="Evento.IdEvento" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Fecha y Hora</label>
                <input asp-for="Evento.Fecha" type="datetime-local" class="form-control" step="60" required data-val-date="Ingrese una fecha válida." />
                <span asp-validation-for="Evento.Fecha" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Premio Total (₡)</label>
                <input asp-for="Evento.PremioTotal" type="number" step="0.01" min="0.01" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Evento.PremioTotal" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select asp-for="Evento.Estado" class="form-select" required>
                    <option value="Programado">Programado</option>
                    <option value="EnCurso">En Curso</option>
                    <option value="Finalizado">Finalizado</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
                <span asp-validation-for="Evento.Estado" class="field-validation-error"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
