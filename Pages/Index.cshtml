@page
@model IndexModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary"><i class="bi bi-award"></i> Hipódromo Nacional</h1>
    <p class="lead">Sistema integral de administración y facturación</p>
    
    <div class="row mt-5">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-success"><i class="bi bi-person-badge"></i> Propietarios</h3>
                    <p class="card-text text-muted">Gestión de propietarios, registro y actualización de datos personales y contactos.</p>
                    <a asp-page="/Propietarios/Create" class="btn btn-outline-success"><i class="bi bi-plus-circle"></i> Nuevo Propietario</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-warning"><i class="bi bi-cash-coin"></i> Facturación</h3>
                    <p class="card-text text-muted">Emisión de facturas y aplicación de beneficios de clientes frecuentes.</p>
                    <a asp-page="/Facturacion/EmitirFactura" class="btn btn-outline-warning"><i class="bi bi-receipt"></i> Módulo de Facturación</a>
                </div>
            </div>
        </div>
    </div>
</div>
