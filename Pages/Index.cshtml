@page
@model IndexModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary"><i class="bi bi-award"></i> Hipódromo Nacional</h1>
    <p class="lead">Sistema integral de administración y facturación</p>
    
    <div class="row mt-5">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-success"><i class="bi bi-people"></i> Propietarios</h3>
                    <p class="card-text text-muted">Gestión de propietarios, registro y actualización de datos.</p>
                    <a asp-page="/Propietarios/Index" class="btn btn-outline-success"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-info"><i class="bi bi-heptagon"></i> Caballos</h3>
                    <p class="card-text text-muted">Registro y control veterinario de los caballos del hipódromo.</p>
                    <a asp-page="/Caballos/Index" class="btn btn-outline-info"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-primary"><i class="bi bi-calendar-event"></i> Eventos</h3>
                    <p class="card-text text-muted">Programación de carreras y gestión de resultados.</p>
                    <a asp-page="/Eventos/Index" class="btn btn-outline-primary"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 mt-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-danger"><i class="bi bi-house-door-fill"></i> Establos</h3>
                    <p class="card-text text-muted">Control de capacidad y mantenimiento de establos.</p>
                    <a asp-page="/Establos/Index" class="btn btn-outline-danger"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-warning"><i class="bi bi-receipt"></i> Facturación</h3>
                    <p class="card-text text-muted">Emisión de facturas y beneficios de clientes frecuentes.</p>
                    <a asp-page="/Facturacion/EmitirFactura" class="btn btn-outline-warning"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-success"><i class="bi bi-pencil-square"></i> Inscripciones</h3>
                    <p class="card-text text-muted">Registro e inscripción de caballos en competencias oficiales.</p>
                    <a asp-page="/Inscripciones/Index" class="btn btn-outline-success"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-primary"><i class="bi bi-trophy"></i> Resultados</h3>
                    <p class="card-text text-muted">Registro de ganadores, tiempos e historial de carreras.</p>
                    <a asp-page="/Resultados/Index" class="btn btn-outline-primary"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 text-start">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-danger"><i class="bi bi-heart-pulse"></i> Vet. e Historial</h3>
                    <p class="card-text text-muted">Controles clínicos, tratamientos y certificados veterinarios.</p>
                    <a asp-page="/Veterinaria/Index" class="btn btn-outline-danger"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 text-start">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-info"><i class="bi bi-box-seam"></i> Suministros y Alim.</h3>
                    <p class="card-text text-muted">Inventario de suministros y raciones de alimentación diaria.</p>
                    <a asp-page="/EstablosMgt/Index" class="btn btn-outline-info"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 text-start">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-warning"><i class="bi bi-bell"></i> Alertas Sanitarias</h3>
                    <p class="card-text text-muted">Notificaciones de vencimiento de certificaciones de salud.</p>
                    <a asp-page="/Alertas/Index" class="btn btn-outline-warning"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 text-start">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h3 class="card-title text-secondary"><i class="bi bi-shield-lock"></i> Auditoría</h3>
                    <p class="card-text text-muted">Visualización de bitácoras del sistema particionadas.</p>
                    <a asp-page="/Auditoria/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right-circle"></i> Ingresar</a>
                </div>
            </div>
        </div>
    </div>
</div>
