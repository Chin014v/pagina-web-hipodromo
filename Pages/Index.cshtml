@page
@model IndexModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container main-dashboard">
    <!-- HERO BANNER SECTION -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="hero-banner p-5 text-center text-md-start d-md-flex align-items-center justify-content-between">
                <div>
                    <h1 class="display-5 fw-bold text-white mb-2"><i class="bi bi-award-fill text-warning me-2"></i>Hipódromo Nacional</h1>
                    <p class="lead text-white-50 mb-0">Sistema integral para la administración hípica, facturación inteligente y control veterinario en tiempo real.</p>
                </div>
                <div class="mt-3 mt-md-0">
                    @{
                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
                        var modeClass = userRole switch
                        {
                            "Administrador" => "bg-warning text-dark",
                            "Veterinario" => "bg-danger text-white",
                            "Propietario" => "bg-success text-white",
                            "EncargadoEstablo" => "bg-info text-white",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge @modeClass px-3 py-2 fs-6 shadow-sm"><i class="bi bi-shield-check me-1"></i> Modo @(userRole == "EncargadoEstablo" ? "Encargado de Establo" : userRole)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- DYNAMIC STATS / KPI SECTION -->
    <div class="row mb-5">
        <div class="col-6 col-lg-3 mb-3">
            <div class="card stat-card border-start border-4 border-info h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-info text-white me-3">
                        <i class="bi bi-heptagon-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.75rem;">@((User.IsInRole("Propietario")) ? "Mis Caballos" : "Caballos")</h6>
                        <h3 class="fw-bold mb-0 text-dark">@Model.CantidadCaballos</h3>
                    </div>
                </div>
            </div>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-6 col-lg-3 mb-3">
                <div class="card stat-card border-start border-4 border-success h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="stat-icon bg-success text-white me-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.75rem;">Propietarios</h6>
                            <h3 class="fw-bold mb-0 text-dark">@Model.CantidadPropietarios</h3>
                          </div>
                      </div>
                  </div>
              </div>
          }
        <div class="col-6 col-lg-3 mb-3">
            <div class="card stat-card border-start border-4 border-warning h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-warning text-dark me-3">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.75rem;">Carreras Activas</h6>
                        <h3 class="fw-bold mb-0 text-dark">@Model.CantidadEventos</h3>
                    </div>
                </div>
            </div>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-6 col-lg-3 mb-3">
                <div class="card stat-card border-start border-4 border-danger h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="stat-icon bg-danger text-white me-3">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.75rem;">Recaudación Total</h6>
                            <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.35rem;">@Model.TotalFacturado.ToString("C2", new System.Globalization.CultureInfo("en-US"))</h3>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- CATEGORIZED MODULES SECTION -->
    <div class="row">
        <!-- CATEGORY 1: OPERACIONES Y FACTURACIÓN -->
        <div class="col-xl-6 mb-4">
            <div class="category-header mb-3">
                <h4 class="text-white fw-bold mb-1"><i class="bi bi-briefcase-fill text-warning me-2"></i>Operaciones y Facturación</h4>
                <p class="text-white-50 mb-0" style="font-size: 0.85rem;">Gestión de clientes, caballos, eventos de carreras y procesos comerciales.</p>
            </div>
            
            <div class="row">
                @if (User.IsInRole("Administrador"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-success"><i class="bi bi-people me-2"></i> Propietarios</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Registro de propietarios, asignación de ubicaciones geográficas y beneficios de cliente frecuente.</p>
                                <a asp-page="/Propietarios/Index" class="btn btn-sm btn-success w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Abrir Gestión</a>
                            </div>
                        </div>
                    </div>
                }
                
                @if (User.IsInRole("Administrador") || User.IsInRole("Propietario") || User.IsInRole("EncargadoEstablo"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-info"><i class="bi bi-heptagon me-2"></i> Caballos</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">@((User.IsInRole("Propietario")) ? "Mis Caballos registrados, identificación de códigos únicos, peso, género y control de salud." : "Fichero general de caballos, identificación de códigos únicos, peso, género y control de estado.")</p>
                                <a asp-page="/Caballos/Index" class="btn btn-sm btn-info text-white w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> @((User.IsInRole("Propietario")) ? "Ver Mis Caballos" : "Abrir Registro")</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-primary"><i class="bi bi-calendar-event me-2"></i> Eventos y Carreras</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Programación de eventos oficiales, configuración de distancias, tipos de carreras y premios.</p>
                                <a asp-page="/Eventos/Index" class="btn btn-sm btn-primary w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Ver Eventos</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("EncargadoEstablo"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-danger"><i class="bi bi-house-door-fill me-2"></i> Establos</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Asignación de boxes y celdas, control de aforo por establo, estados de mantenimiento y capacidad física.</p>
                                <a asp-page="/Establos/Index" class="btn btn-sm btn-danger w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Ver Establos</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Propietario"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-warning"><i class="bi bi-receipt me-2"></i> Facturación</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">@((User.IsInRole("Propietario")) ? "Consulta el historial de facturas emitidas a tu nombre y realiza tus pagos pendientes." : "Emisión de facturas detalladas a propietarios, cálculo de IVA, comisiones administrativas e historial.")</p>
                                <div class="d-flex gap-2 mt-2">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-page="/Facturacion/EmitirFactura" class="btn btn-sm btn-warning w-50"><i class="bi bi-plus-circle me-1"></i> Emitir</a>
                                        <a asp-page="/Facturacion/Historial" class="btn btn-sm btn-outline-warning w-50"><i class="bi bi-journal-text me-1"></i> Historial</a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Facturacion/Historial" class="btn btn-sm btn-warning w-100"><i class="bi bi-journal-text me-1"></i> Ver Mis Facturas</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Propietario"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-success"><i class="bi bi-pencil-square me-2"></i> Inscripciones</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">@((User.IsInRole("Propietario")) ? "Inscribe tus ejemplares en las carreras programadas con comprobación del estado de salud." : "Inscripción oficial de ejemplares en las carreras programadas con comprobación de estado.")</p>
                                <a asp-page="/Inscripciones/Index" class="btn btn-sm btn-outline-success w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Gestionar Inscripciones</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- CATEGORY 2: CONTROL CLÍNICO, INVENTARIO Y SEGURIDAD -->
        <div class="col-xl-6 mb-4">
            <div class="category-header mb-3">
                <h4 class="text-white fw-bold mb-1"><i class="bi bi-shield-fill-check text-warning me-2"></i>Control Técnico, Médico y Auditoría</h4>
                <p class="text-white-50 mb-0" style="font-size: 0.85rem;">Seguimiento clínico de veterinaria, inventario, bitácoras de base de datos y control de accesos.</p>
            </div>
            
            <div class="row">
                @if (User.IsInRole("Administrador") || User.IsInRole("Propietario") || User.IsInRole("EncargadoEstablo"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-primary"><i class="bi bi-trophy me-2"></i> Resultados Oficiales</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Registro de posiciones, cronometraje preciso en pista y cálculo dinámico de distribución de premios.</p>
                                <a asp-page="/Resultados/Index" class="btn btn-sm btn-primary w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Resultados</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Veterinario"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-danger"><i class="bi bi-heart-pulse me-2"></i> Historial Clínico</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Historial médico veterinario, registros clínicos, diagnósticos aplicados y emisión de certificados vigentes.</p>
                                <a asp-page="/Veterinaria/Index" class="btn btn-sm btn-danger w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Ver Fichas Médicas</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("EncargadoEstablo"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-info"><i class="bi bi-box-seam me-2"></i> Suministros y Alimentación</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Control de stock de alimentos y medicinas. Registro detallado de raciones diarias administradas a caballos.</p>
                                <a asp-page="/EstablosMgt/Index" class="btn btn-sm btn-info text-white w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Abrir Suministros</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Veterinario"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-warning"><i class="bi bi-bell me-2"></i> Alertas Sanitarias</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Sistema de notificaciones automáticas para vencimiento de certificados médicos de los caballos en pista.</p>
                                <a asp-page="/Alertas/Index" class="btn btn-sm btn-warning w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Ver Notificaciones</a>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-secondary"><i class="bi bi-shield-lock me-2"></i> Bitácoras de Auditoría</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Visor de auditoría de base de datos particionado cronológicamente por trimestre. Tracking de transacciones.</p>
                                <a asp-page="/Auditoria/Index" class="btn btn-sm btn-secondary w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Auditoría BD</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="card h-100 dashboard-module-card">
                            <div class="card-body">
                                <h5 class="card-title text-dark"><i class="bi bi-person-gear me-2"></i> Control de Usuarios</h5>
                                <p class="card-text text-muted" style="font-size: 0.85rem;">Gestión de credenciales, perfiles y roles (Administrador, Veterinario, Propietario, Facturación) del sistema.</p>
                                <a asp-page="/Usuarios/Index" class="btn btn-sm btn-outline-dark w-100 mt-2"><i class="bi bi-arrow-right-circle me-1"></i> Usuarios</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
