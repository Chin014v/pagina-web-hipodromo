@page
@model HipodromoNacional.Pages.Alertas.IndexModel
@{
    ViewData["Title"] = "Alertas de Certificación";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-bell"></i> Alertas de Certificación</h2>
    </div>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva alerta</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Caballo</th>
                <th>Mensaje</th>
                <th>Fecha Alerta</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Alertas)
            {
                <tr>
                    <td>@item.NombreCaballo</td>
                    <td>@item.Mensaje</td>
                    <td>@item.FechaAlerta.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @switch (item.Estado)
                        {
                            case "Pendiente":
                                <span class="badge bg-warning text-dark">Pendiente</span>
                                break;
                            case "Revisada":
                                <span class="badge bg-info text-dark">Revisada</span>
                                break;
                            case "Resuelta":
                                <span class="badge bg-success">Resuelta</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@item.Estado</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@item.IdAlerta" class="btn btn-sm btn-outline-warning" title="Cambiar Estado"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@item.IdAlerta" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
