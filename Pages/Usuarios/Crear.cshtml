@page
@model HipodromoNacional.Pages.Usuarios.CrearModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container px-4">
    <div class="my-4">
        <h1><i class="bi bi-plus-circle text-primary"></i> Nuevo Usuario</h1>
        <p class="text-muted">Ingresa los datos para registrar un usuario e indicarle su rol de negocio en la plataforma.</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.Nombre">Nombre de Usuario</label>
                            <input class="form-control" asp-for="Usuario.Nombre" placeholder="Ej. manuel_prop" />
                            <span class="text-danger" asp-validation-for="Usuario.Nombre"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.Contrasena">Contraseña</label>
                            <input type="password" class="form-control" asp-for="Usuario.Contrasena" placeholder="Ingresa contraseña" />
                            <span class="text-danger" asp-validation-for="Usuario.Contrasena"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.IdRol">Rol del Usuario</label>
                            <select class="form-select" asp-for="Usuario.IdRol" id="rolSelect">
                                <option value="" data-role-group="">-- Seleccione un Rol --</option>
                                @foreach (var r in Model.Roles
                                    .Where(r => r.NombreRol == "Administrador" || r.NombreRol == "Propietario" || r.NombreRol == "Veterinario" || r.NombreRol == "EncargadoEstablo"))
                                {
                                    var group = r.NombreRol switch
                                    {
                                        "Propietario" => "propietario",
                                        "Veterinario" => "veterinario",
                                        "EncargadoEstablo" => "encargado",
                                        _ => ""
                                    };
                                    <option value="@r.IdRol" data-role-group="@group">@(r.NombreRol == "EncargadoEstablo" ? "Encargado de Establo" : r.NombreRol) (@r.Descripcion)</option>
                                }
                            </select>

                            <span class="text-danger" asp-validation-for="Usuario.IdRol"></span>
                        </div>

                        <div class="mb-3 d-none" id="propietarioField">
                            <label class="form-label" asp-for="Usuario.IdPropietario">Propietario Vinculado</label>
                            <select class="form-select" asp-for="Usuario.IdPropietario">
                                <option value="">-- Seleccione Propietario --</option>
                                @foreach (var p in Model.Propietarios)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Usuario.IdPropietario"></span>
                        </div>

                        <div class="mb-3 d-none" id="veterinarioField">
                            <label class="form-label" asp-for="Usuario.IdVeterinario">Veterinario Vinculado</label>
                            <select class="form-select" asp-for="Usuario.IdVeterinario">
                                <option value="">-- Seleccione Veterinario --</option>
                                @foreach (var v in Model.Veterinarios)
                                {
                                    <option value="@v.Id">@v.Nombre</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Usuario.IdVeterinario"></span>
                        </div>

                        <div class="mb-3 d-none" id="encargadoField">
                            <label class="form-label">Encargado de Establo Vinculado</label>
                            <select class="form-select" asp-for="Usuario.IdEncargadoEstablo">
                                <option value="">-- Seleccione Encargado --</option>
                                @foreach (var e in Model.Encargados)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Registrar Usuario</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            function toggleFields() {
                var selectedOpt = $("#rolSelect").find(":selected");
                var group = selectedOpt.data("role-group") || "";

                $("#propietarioField, #veterinarioField, #encargadoField").addClass("d-none");
                $("#Usuario_IdPropietario, #Usuario_IdVeterinario, #Usuario_IdEncargadoEstablo").val("");

                if (group) {
                    $("#" + group + "Field").removeClass("d-none");
                }
            }

            $("#rolSelect").change(toggleFields);
            toggleFields();
        });
    </script>
}
