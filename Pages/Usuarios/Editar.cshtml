@page
@model HipodromoNacional.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container px-4">
    <div class="my-4">
        <h1><i class="bi bi-pencil text-warning"></i> Editar Usuario</h1>
        <p class="text-muted">Actualiza los datos del usuario seleccionado, su rol de seguridad o estado de activación.</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Usuario.IdUsuario" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.Nombre">Nombre de Usuario</label>
                            <input class="form-control" asp-for="Usuario.Nombre" readonly />
                            <span class="text-danger" asp-validation-for="Usuario.Nombre"></span>
                            <small class="text-muted">El nombre de usuario no puede ser modificado.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.Contrasena">Nueva Contraseña (Opcional)</label>
                            <input type="password" class="form-control" asp-for="Usuario.Contrasena" placeholder="Dejar en blanco para mantener la contraseña actual" />
                            <span class="text-danger" asp-validation-for="Usuario.Contrasena"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.IdRol">Rol del Usuario</label>
                            <select class="form-select" asp-for="Usuario.IdRol">
                                @foreach (var r in Model.Roles)
                                {
                                    <option value="@r.IdRol">@r.NombreRol (@r.Descripcion)</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="Usuario.IdRol"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Usuario.Activo">Estado de Cuenta</label>
                            <select class="form-select" asp-for="Usuario.Activo">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                            <span class="text-danger" asp-validation-for="Usuario.Activo"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
