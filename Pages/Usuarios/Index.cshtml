@page
@model HipodromoNacional.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Control de Usuarios";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div class="d-flex align-items-center">
            <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
            <h1 class="mb-0"><i class="bi bi-person-gear text-dark"></i> Control de Usuarios</h1>
        </div>
        <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Usuario</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Vinculado A</th>
                            <th>Estado</th>
                            <th>Fecha Creación</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Usuarios.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No hay usuarios registrados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Usuarios)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Nombre</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@(item.NombreRol == "EncargadoEstablo" ? "Encargado de Establo" : item.NombreRol)</span>
                                    </td>
                                    <td>
                                        @if (item.IdPropietario.HasValue)
                                        {
                                            <span>Propietario: @item.NombrePropietario</span>
                                        }
                                        else if (item.IdVeterinario.HasValue)
                                        {
                                            <span>Veterinario: @item.NombreVeterinario</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">(Ninguno - Admin/Establo)</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span>
                                    </td>
                                    <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end px-4">
                                        <a asp-page="./Editar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i> Editar</a>
                                        <a asp-page="./Eliminar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
