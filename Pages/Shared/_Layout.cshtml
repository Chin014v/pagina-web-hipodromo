<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hipódromo Nacional</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HipodromoNacional.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-hipico mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-trophy-fill"></i> Hipódromo Nacional
                    <small>Sistema de Control de Carreras</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house-door"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Propietarios/Index"><i class="bi bi-people"></i> Propietarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Caballos/Index"><i class="bi bi-heptagon"></i> Caballos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Eventos/Index"><i class="bi bi-calendar-event"></i> Eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Establos/Index"><i class="bi bi-house-door-fill"></i> Establos</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownFact" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-receipt"></i> Facturación
                            </a>
                            <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="navbarDropdownFact">
                                <li><a class="dropdown-item" asp-page="/Facturacion/EmitirFactura"><i class="bi bi-plus-circle me-2 text-primary"></i> Emitir Factura</a></li>
                                <li><a class="dropdown-item" asp-page="/Facturacion/Historial"><i class="bi bi-journal-text me-2 text-secondary"></i> Historial de Facturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Estadisticas/Index"><i class="bi bi-bar-chart me-2 text-success"></i> Estadísticas y Reportes</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-3x3-gap"></i> Módulos
                            </a>
                            <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" asp-page="/Inscripciones/Index"><i class="bi bi-pencil-square me-2 text-success"></i> Inscripciones</a></li>
                                <li><a class="dropdown-item" asp-page="/Resultados/Index"><i class="bi bi-trophy me-2 text-primary"></i> Resultados</a></li>
                                <li><a class="dropdown-item" asp-page="/Veterinaria/Index"><i class="bi bi-heart-pulse me-2 text-danger"></i> Historial Veterinario</a></li>
                                <li><a class="dropdown-item" asp-page="/EstablosMgt/Index"><i class="bi bi-box-seam me-2 text-info"></i> Suministros y Alimentación</a></li>
                                <li><a class="dropdown-item" asp-page="/Razas/Index"><i class="bi bi-bookmark-fill me-2 text-warning"></i> Razas de Caballos</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Alertas/Index"><i class="bi bi-bell me-2 text-warning"></i> Alertas Sanitarias</a></li>
                                <li><a class="dropdown-item" asp-page="/Auditoria/Index"><i class="bi bi-shield-lock me-2 text-secondary"></i> Bitácora de Auditoría</a></li>
                                <li><a class="dropdown-item" asp-page="/Usuarios/Index"><i class="bi bi-person-gear me-2 text-dark"></i> Control de Usuarios</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="nav-link text-white font-weight-bold">
                                <i class="bi bi-person-circle text-warning"></i> admin <span class="badge bg-warning text-dark ms-1">Administrador</span>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 mt-auto">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year - Hipódromo Nacional · Sistema de Control de Carreras de Caballos</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
