@page
@model HipodromoNacional.Pages.Facturacion.EmitirFacturaModel
@{
    ViewData["Title"] = "Emitir Factura";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <a asp-page="/Index" class="btn btn-light btn-sm text-success me-3 fw-bold"><i class="bi bi-arrow-left"></i> Regresar</a>
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Emisión de Factura</h4>
        </div>
        <button type="button" id="btnCalcularFrecuentes" class="btn btn-light btn-sm text-success fw-bold">
            <i class="bi bi-stars"></i> Aplicar Descuentos Frecuentes
        </button>
    </div>
    <div class="card-body">
        <form id="facturaForm" method="post">
            <h5 class="text-secondary border-bottom pb-2 mb-3">Información del Cliente y Carrera</h5>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Propietario / Cliente</label>
                    <select asp-for="IdPropietario" class="form-select calc-trigger" required data-val-number="Ingrese un número válido.">
                        <option value="">Seleccione el propietario...</option>
                        @foreach (var p in Model.Propietarios)
                        {
                            <option value="@p.IdPropietario" data-descuento="@(p.DescuentoProximaFactura ? "10" : "0")">
                                @p.Nombre @p.Apellido1 (@p.Cedula) @(p.DescuentoProximaFactura ? "â˜… (Descuento 10% Disponible)" : "")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Evento / Carrera</label>
                    <select asp-for="IdEvento" class="form-select calc-trigger" required data-val-number="Ingrese un número válido." disabled>
                        <option value="">Seleccione el propietario primero...</option>
                    </select>
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Información de Pago</h5>
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label">Método de Pago</label>
                    <select asp-for="IdMetodoPago" class="form-select">
                        <option value="">-- Sin Pago (Queda Pendiente) --</option>
                        <option value="1">Sinpe Móvil</option>
                        <option value="2">Tarjeta de Crédito</option>
                        <option value="3">Transferencia Bancaria</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Referencia de Pago</label>
                    <input asp-for="Referencia" class="form-control" placeholder="Ej. Transacción #12345" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de Comprobante</label>
                    <input asp-for="NumeroComprobante" class="form-control" placeholder="Ej. SINPE-84729" />
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Cálculo de Precios Estimados</h5>
            <div class="bg-light p-3 rounded border mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal de Inscripción:</span>
                    <strong id="lblSubtotal">â‚¡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-danger">
                    <span>Descuento de Cliente Frecuente:</span>
                    <strong id="lblDescuento">- â‚¡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Base Imponible:</span>
                    <strong id="lblBase">â‚¡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>IVA (13%):</span>
                    <strong id="lblIVA">â‚¡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-warning">
                    <span>Comisión Administrativa (5%):</span>
                    <strong id="lblComision">â‚¡0.00</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <h5 class="mb-0">Total estimado a Pagar:</h5>
                    <h4 class="mb-0 text-primary" id="lblTotal">â‚¡0.00</h4>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-success btn-lg w-100">
                    <i class="bi bi-receipt-cutoff"></i> Registrar y Emitir Factura Oficial
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.FacturaRecienCreada != null)
{
    <!-- Modal Detalle Factura -->
    <div class="modal fade" id="invoiceModal" tabindex="-1" aria-labelledby="invoiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="invoiceModalLabel">
                        <i class="bi bi-file-earmark-ruled"></i> Detalle de Factura Emitida
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light">
                    
                    <!-- Contenedor imprimible -->
                    <div id="printArea" class="bg-white p-4 rounded shadow-sm border border-secondary">
                        <div class="row align-items-center mb-4">
                            <div class="col-8">
                                <h3 class="text-success mb-1 fw-bold">HIPÃ“DROMO NACIONAL</h3>
                                <p class="text-muted small mb-0">Sistema de Control y Facturación de Carreras de Caballos</p>
                                <span class="badge bg-success">FACTURA OFICIAL</span>
                            </div>
                            <div class="col-4 text-end">
                                <h5 class="mb-1 text-danger fw-bold">No. @Model.FacturaRecienCreada.CodigoFactura</h5>
                                <p class="text-muted small mb-0">Fecha: @Model.FacturaRecienCreada.FechaEmision.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <hr class="border-secondary" />

                        <div class="row mb-4">
                            <div class="col-6">
                                <h6 class="fw-bold text-secondary">DATOS DEL CLIENTE</h6>
                                <p class="mb-1"><strong>Nombre:</strong> @Model.FacturaRecienCreada.ClienteNombre</p>
                                <p class="mb-0"><strong>Cédula:</strong> @Model.FacturaRecienCreada.ClienteCedula</p>
                            </div>
                            <div class="col-6">
                                <h6 class="fw-bold text-secondary">EVENTO / CARRERA</h6>
                                <p class="mb-1"><strong>Nombre:</strong> @Model.FacturaRecienCreada.EventoNombre</p>
                                <p class="mb-0"><strong>Código:</strong> @Model.FacturaRecienCreada.EventoCodigo</p>
                            </div>
                        </div>

                        <h6 class="fw-bold text-secondary mb-2">DETALLE DE INSCRIPCIONES</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped align-middle">
                                <thead class="table-dark text-white">
                                    <tr>
                                        <th>Descripción</th>
                                        <th class="text-center" style="width: 100px;">Cantidad</th>
                                        <th class="text-end" style="width: 150px;">Precio Unitario</th>
                                        <th class="text-end" style="width: 150px;">Total Línea</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var linea in Model.FacturaRecienCreada.Lineas)
                                    {
                                        <tr>
                                            <td>@linea.Descripcion</td>
                                            <td class="text-center">@linea.Cantidad.ToString("F0")</td>
                                            <td class="text-end">â‚¡@linea.PrecioUnitario.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                            <td class="text-end fw-semibold">â‚¡@linea.SubtotalLinea.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row justify-content-end mt-4">
                            <div class="col-6 text-end">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Subtotal:</td>
                                        <td style="width: 150px;">â‚¡@Model.FacturaRecienCreada.Subtotal.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                    @if (Model.FacturaRecienCreada.PorcentajeDescuento > 0)
                                    {
                                        <tr class="text-danger">
                                            <td>Descuento Frecuente (@Model.FacturaRecienCreada.PorcentajeDescuento.ToString("F0")%):</td>
                                            <td>- â‚¡@Model.FacturaRecienCreada.MontoDescuento.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td class="text-muted">Base Imponible:</td>
                                        <td>â‚¡@Model.FacturaRecienCreada.BaseImponible.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">IVA (13%):</td>
                                        <td>â‚¡@Model.FacturaRecienCreada.ImpuestoIva.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                    <tr class="text-warning-emphasis">
                                        <td class="text-muted">Comisión Admin (5%):</td>
                                        <td>â‚¡@Model.FacturaRecienCreada.ComisionAdmin.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                    <tr class="border-top border-dark fs-5 fw-bold text-primary">
                                        <td>Total a Pagar:</td>
                                        <td>â‚¡@Model.FacturaRecienCreada.Total.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.FacturaRecienCreada.MetodoPago))
                        {
                            <hr class="border-secondary mt-3" />
                            <div class="bg-success-subtle p-3 rounded border border-success text-success-emphasis">
                                <h6 class="fw-bold text-success mb-2"><i class="bi bi-credit-card-2-back"></i> INFORMACIÃ“N DEL PAGO</h6>
                                <div class="row small">
                                    <div class="col-6">
                                        <p class="mb-1"><strong>Método:</strong> @Model.FacturaRecienCreada.MetodoPago</p>
                                        <p class="mb-0"><strong>Fecha:</strong> @(Model.FacturaRecienCreada.FechaPago?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</p>
                                    </div>
                                    <div class="col-6">
                                        <p class="mb-1"><strong>Referencia:</strong> @Model.FacturaRecienCreada.ReferenciaPago</p>
                                        <p class="mb-0"><strong>Comprobante:</strong> @Model.FacturaRecienCreada.ComprobantePago</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <hr class="border-secondary mt-3" />
                            <div class="bg-warning-subtle p-3 rounded border border-warning text-warning-emphasis">
                                <p class="mb-0 small"><i class="bi bi-clock-history"></i> Esta factura se ha emitido en estado <strong>PENDIENTE DE PAGO</strong>. Fecha de vencimiento: @(Model.FacturaRecienCreada.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-").</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" onclick="printInvoice()"><i class="bi bi-printer"></i> Imprimir Factura</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Estilos de Impresión -->
    <style>
        @@media print {
            body * {
                visibility: hidden !important;
            }
            #printArea, #printArea * {
                visibility: visible !important;
            }
            #printArea {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
            }
            .modal-backdrop, .modal-footer, .btn-close {
                display: none !important;
            }
        }
    </style>
}

@section Scripts {
<script>
    const IVA_RATE = 0.13;
    const COMISION_RATE = 0.05;

    function calcularFactura() {
        const ddlPropietario = document.getElementById('IdPropietario');
        const ddlEvento = document.getElementById('IdEvento');

        if (!ddlPropietario || !ddlEvento) return;

        const optPropietario = ddlPropietario.options[ddlPropietario.selectedIndex];
        const optEvento = ddlEvento.options[ddlEvento.selectedIndex];

        // Obtener descuento del propietario seleccionado
        const descPorcentaje = optPropietario && optPropietario.value ? parseFloat(optPropietario.getAttribute('data-descuento')) || 0 : 0;
        
        // Obtener precio del evento seleccionado
        const subtotal = optEvento && optEvento.value ? parseFloat(optEvento.getAttribute('data-precio')) || 0 : 0;

        const descuentoMonto = subtotal * (descPorcentaje / 100);
        const baseImponible = subtotal - descuentoMonto;
        const iva = baseImponible * IVA_RATE;
        const comision = subtotal * COMISION_RATE; 
        const total = baseImponible + iva + comision;

        const formatoColon = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' });

        document.getElementById('lblSubtotal').innerText = formatoColon.format(subtotal);
        document.getElementById('lblDescuento').innerText = "- " + formatoColon.format(descuentoMonto) + " (" + descPorcentaje + "%)";
        document.getElementById('lblBase').innerText = formatoColon.format(baseImponible);
        document.getElementById('lblIVA').innerText = formatoColon.format(iva);
        document.getElementById('lblComision').innerText = formatoColon.format(comision);
        document.getElementById('lblTotal').innerText = formatoColon.format(total);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const ddlPropietario = document.getElementById('IdPropietario');
        const ddlEvento = document.getElementById('IdEvento');
        const btnCalcularFrecuentes = document.getElementById('btnCalcularFrecuentes');
        const ddlMetodoPago = document.getElementById('IdMetodoPago');
        const txtReferencia = document.getElementById('Referencia');
        const txtNumeroComprobante = document.getElementById('NumeroComprobante');

        // 1. Cargar Eventos Pendientes según Propietario
        ddlPropietario.addEventListener('change', async function () {
            const propietarioId = this.value;
            ddlEvento.innerHTML = '<option value="">Cargando eventos...</option>';
            ddlEvento.disabled = true;
            
            // Resetear cálculos
            document.getElementById('lblSubtotal').innerText = "â‚¡0.00";
            document.getElementById('lblDescuento').innerText = "- â‚¡0.00";
            document.getElementById('lblBase').innerText = "â‚¡0.00";
            document.getElementById('lblIVA').innerText = "â‚¡0.00";
            document.getElementById('lblComision').innerText = "â‚¡0.00";
            document.getElementById('lblTotal').innerText = "â‚¡0.00";

            if (!propietarioId) {
                ddlEvento.innerHTML = '<option value="">Seleccione el propietario primero...</option>';
                return;
            }

            try {
                const response = await fetch(`?handler=EventosPendientes&propietarioId=${propietarioId}`);
                const data = await response.json();
                
                ddlEvento.innerHTML = '';
                if (data && data.length > 0) {
                    const defaultOpt = document.createElement('option');
                    defaultOpt.value = '';
                    defaultOpt.textContent = 'Seleccione el evento...';
                    ddlEvento.appendChild(defaultOpt);

                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.id;
                        opt.setAttribute('data-precio', item.precio);
                        opt.textContent = `${item.nombre} - Código: ${item.codigo} (Precio Base: â‚¡${new Intl.NumberFormat('es-CR').format(item.precio)})`;
                        ddlEvento.appendChild(opt);
                    });
                    ddlEvento.disabled = false;
                } else {
                    ddlEvento.innerHTML = '<option value="">Este propietario no tiene inscripciones pendientes en ningún evento.</option>';
                }
            } catch (err) {
                console.error("Error al cargar eventos pendientes:", err);
                ddlEvento.innerHTML = '<option value="">Error al cargar eventos.</option>';
            }
        });

        // 2. Aplicar Descuentos Frecuentes vía AJAX
        btnCalcularFrecuentes.addEventListener('click', async function () {
            const prevSelectedVal = ddlPropietario.value;
            
            btnCalcularFrecuentes.disabled = true;
            btnCalcularFrecuentes.innerHTML = '<i class="bi bi-hourglass-split"></i> Calculando...';

            try {
                const response = await fetch('?handler=CalcularFrecuentes');
                const data = await response.json();

                if (data && data.success) {
                    // Actualizar el dropdown de propietarios
                    ddlPropietario.innerHTML = '<option value="">Seleccione el propietario...</option>';
                    data.propietarios.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p.idPropietario;
                        opt.setAttribute('data-descuento', p.descuentoProximaFactura ? "10" : "0");
                        
                        let displayVal = `${p.nombre} ${p.apellido1} (${p.cedula})`;
                        if (p.descuentoProximaFactura) {
                            displayVal += " â˜… (Descuento 10% Disponible)";
                        }
                        opt.textContent = displayVal;
                        ddlPropietario.appendChild(opt);
                    });

                    // Restaurar la selección previa
                    ddlPropietario.value = prevSelectedVal;

                    // Recalcular
                    calcularFactura();

                    // Mostrar alerta de éxito
                    alert("Descuentos de propietarios frecuentes recalculados y aplicados correctamente.");
                } else {
                    alert("Error al recalcular descuentos: " + (data.message || "Desconocido"));
                }
            } catch (err) {
                console.error("Error al calcular frecuentes:", err);
                alert("Ocurrió un error de red al intentar calcular frecuentes.");
            } finally {
                btnCalcularFrecuentes.disabled = false;
                btnCalcularFrecuentes.innerHTML = '<i class="bi bi-stars"></i> Aplicar Descuentos Frecuentes';
            }
        });

        // 3. Autocompletar Referencia y Comprobante
        ddlMetodoPago.addEventListener('change', function () {
            if (this.value) {
                // Si el usuario no ha ingresado nada, autogeneramos datos válidos y únicos
                if (!txtReferencia.value) {
                    txtReferencia.value = 'REF-' + Date.now();
                }
                if (!txtNumeroComprobante.value) {
                    txtNumeroComprobante.value = 'COMP-' + Math.floor(100000 + Math.random() * 900000);
                }
            } else {
                txtReferencia.value = '';
                txtNumeroComprobante.value = '';
            }
        });

        ddlEvento.addEventListener('change', calcularFactura);
        ddlPropietario.addEventListener('change', calcularFactura);

        @if (Model.FacturaRecienCreada != null)
        {
            <text>
            const invoiceModal = new bootstrap.Modal(document.getElementById('invoiceModal'));
            invoiceModal.show();
            </text>
        }
    });

    function printInvoice() {
        window.print();
    }
</script>
}
