@page
@model HipodromoNacional.Pages.Facturacion.EmitirFacturaModel
@{
    ViewData["Title"] = "Emitir Factura";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="bi bi-receipt"></i> Emisión de Factura</h4>
        <button type="button" id="btnCalcularFrecuentes" class="btn btn-light btn-sm text-success fw-bold">
            <i class="bi bi-stars"></i> Aplicar Descuentos Frecuentes
        </button>
    </div>
    <div class="card-body">
        <form id="facturaForm" method="post">
            <h5 class="text-secondary border-bottom pb-2 mb-3">Información del Cliente y Carrera</h5>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Propietario / Cliente</label>
                    <select asp-for="IdPropietario" class="form-select calc-trigger" required>
                        <option value="">Seleccione el propietario...</option>
                        @foreach (var p in Model.Propietarios)
                        {
                            <option value="@p.IdPropietario" data-descuento="@(p.DescuentoProximaFactura ? "10" : "0")">
                                @p.Nombre @p.Apellido1 (@p.Cedula) @(p.DescuentoProximaFactura ? "★ (Descuento 10% Disponible)" : "")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Evento / Carrera</label>
                    <select asp-for="IdEvento" class="form-select calc-trigger" required disabled>
                        <option value="">Seleccione el propietario primero...</option>
                    </select>
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Información de Pago</h5>
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label">Método de Pago</label>
                    <select asp-for="IdMetodoPago" class="form-select">
                        <option value="">-- Sin Pago (Queda Pendiente) --</option>
                        <option value="1">Sinpe Móvil</option>
                        <option value="2">Tarjeta de Crédito</option>
                        <option value="3">Transferencia Bancaria</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Referencia de Pago</label>
                    <input asp-for="Referencia" class="form-control" placeholder="Ej. Transacción #12345" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de Comprobante</label>
                    <input asp-for="NumeroComprobante" class="form-control" placeholder="Ej. SINPE-84729" />
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Cálculo de Precios Estimados</h5>
            <div class="bg-light p-3 rounded border mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal de Inscripción:</span>
                    <strong id="lblSubtotal">₡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-danger">
                    <span>Descuento de Cliente Frecuente:</span>
                    <strong id="lblDescuento">- ₡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Base Imponible:</span>
                    <strong id="lblBase">₡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>IVA (13%):</span>
                    <strong id="lblIVA">₡0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 text-warning">
                    <span>Comisión Administrativa (5%):</span>
                    <strong id="lblComision">₡0.00</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <h5 class="mb-0">Total estimado a Pagar:</h5>
                    <h4 class="mb-0 text-primary" id="lblTotal">₡0.00</h4>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-success btn-lg w-100">
                    <i class="bi bi-receipt-cutoff"></i> Registrar y Emitir Factura Oficial
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const IVA_RATE = 0.13;
    const COMISION_RATE = 0.05;

    function calcularFactura() {
        const ddlPropietario = document.getElementById('IdPropietario');
        const ddlEvento = document.getElementById('IdEvento');

        if (!ddlPropietario || !ddlEvento) return;

        const optPropietario = ddlPropietario.options[ddlPropietario.selectedIndex];
        const optEvento = ddlEvento.options[ddlEvento.selectedIndex];

        // Obtener descuento del propietario seleccionado
        const descPorcentaje = optPropietario && optPropietario.value ? parseFloat(optPropietario.getAttribute('data-descuento')) || 0 : 0;
        
        // Obtener precio del evento seleccionado
        const subtotal = optEvento && optEvento.value ? parseFloat(optEvento.getAttribute('data-precio')) || 0 : 0;

        const descuentoMonto = subtotal * (descPorcentaje / 100);
        const baseImponible = subtotal - descuentoMonto;
        const iva = baseImponible * IVA_RATE;
        const comision = subtotal * COMISION_RATE; 
        const total = baseImponible + iva + comision;

        const formatoColon = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' });

        document.getElementById('lblSubtotal').innerText = formatoColon.format(subtotal);
        document.getElementById('lblDescuento').innerText = "- " + formatoColon.format(descuentoMonto) + " (" + descPorcentaje + "%)";
        document.getElementById('lblBase').innerText = formatoColon.format(baseImponible);
        document.getElementById('lblIVA').innerText = formatoColon.format(iva);
        document.getElementById('lblComision').innerText = formatoColon.format(comision);
        document.getElementById('lblTotal').innerText = formatoColon.format(total);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const ddlPropietario = document.getElementById('IdPropietario');
        const ddlEvento = document.getElementById('IdEvento');
        const btnCalcularFrecuentes = document.getElementById('btnCalcularFrecuentes');
        const ddlMetodoPago = document.getElementById('IdMetodoPago');
        const txtReferencia = document.getElementById('Referencia');
        const txtNumeroComprobante = document.getElementById('NumeroComprobante');

        // 1. Cargar Eventos Pendientes según Propietario
        ddlPropietario.addEventListener('change', async function () {
            const propietarioId = this.value;
            ddlEvento.innerHTML = '<option value="">Cargando eventos...</option>';
            ddlEvento.disabled = true;
            
            // Resetear cálculos
            document.getElementById('lblSubtotal').innerText = "₡0.00";
            document.getElementById('lblDescuento').innerText = "- ₡0.00";
            document.getElementById('lblBase').innerText = "₡0.00";
            document.getElementById('lblIVA').innerText = "₡0.00";
            document.getElementById('lblComision').innerText = "₡0.00";
            document.getElementById('lblTotal').innerText = "₡0.00";

            if (!propietarioId) {
                ddlEvento.innerHTML = '<option value="">Seleccione el propietario primero...</option>';
                return;
            }

            try {
                const response = await fetch(`?handler=EventosPendientes&propietarioId=${propietarioId}`);
                const data = await response.json();
                
                ddlEvento.innerHTML = '';
                if (data && data.length > 0) {
                    const defaultOpt = document.createElement('option');
                    defaultOpt.value = '';
                    defaultOpt.textContent = 'Seleccione el evento...';
                    ddlEvento.appendChild(defaultOpt);

                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.id;
                        opt.setAttribute('data-precio', item.precio);
                        opt.textContent = `${item.nombre} - Código: ${item.codigo} (Precio Base: ₡${new Intl.NumberFormat('es-CR').format(item.precio)})`;
                        ddlEvento.appendChild(opt);
                    });
                    ddlEvento.disabled = false;
                } else {
                    ddlEvento.innerHTML = '<option value="">Este propietario no tiene inscripciones pendientes en ningún evento.</option>';
                }
            } catch (err) {
                console.error("Error al cargar eventos pendientes:", err);
                ddlEvento.innerHTML = '<option value="">Error al cargar eventos.</option>';
            }
        });

        // 2. Aplicar Descuentos Frecuentes vía AJAX
        btnCalcularFrecuentes.addEventListener('click', async function () {
            const prevSelectedVal = ddlPropietario.value;
            
            btnCalcularFrecuentes.disabled = true;
            btnCalcularFrecuentes.innerHTML = '<i class="bi bi-hourglass-split"></i> Calculando...';

            try {
                const response = await fetch('?handler=CalcularFrecuentes');
                const data = await response.json();

                if (data && data.success) {
                    // Actualizar el dropdown de propietarios
                    ddlPropietario.innerHTML = '<option value="">Seleccione el propietario...</option>';
                    data.propietarios.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p.idPropietario;
                        opt.setAttribute('data-descuento', p.descuentoProximaFactura ? "10" : "0");
                        
                        let displayVal = `${p.nombre} ${p.apellido1} (${p.cedula})`;
                        if (p.descuentoProximaFactura) {
                            displayVal += " ★ (Descuento 10% Disponible)";
                        }
                        opt.textContent = displayVal;
                        ddlPropietario.appendChild(opt);
                    });

                    // Restaurar la selección previa
                    ddlPropietario.value = prevSelectedVal;

                    // Recalcular
                    calcularFactura();

                    // Mostrar alerta de éxito
                    alert("Descuentos de propietarios frecuentes recalculados y aplicados correctamente.");
                } else {
                    alert("Error al recalcular descuentos: " + (data.message || "Desconocido"));
                }
            } catch (err) {
                console.error("Error al calcular frecuentes:", err);
                alert("Ocurrió un error de red al intentar calcular frecuentes.");
            } finally {
                btnCalcularFrecuentes.disabled = false;
                btnCalcularFrecuentes.innerHTML = '<i class="bi bi-stars"></i> Aplicar Descuentos Frecuentes';
            }
        });

        // 3. Autocompletar Referencia y Comprobante
        ddlMetodoPago.addEventListener('change', function () {
            if (this.value) {
                // Si el usuario no ha ingresado nada, autogeneramos datos válidos y únicos
                if (!txtReferencia.value) {
                    txtReferencia.value = 'REF-' + Date.now();
                }
                if (!txtNumeroComprobante.value) {
                    txtNumeroComprobante.value = 'COMP-' + Math.floor(100000 + Math.random() * 900000);
                }
            } else {
                txtReferencia.value = '';
                txtNumeroComprobante.value = '';
            }
        });

        ddlEvento.addEventListener('change', calcularFactura);
        ddlPropietario.addEventListener('change', calcularFactura);
    });
</script>
}
