@page
@model HipodromoNacional.Pages.Facturacion.HistorialModel
@{
    ViewData["Title"] = "Historial de Facturas";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div class="d-flex align-items-center">
            <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
            <h1 class="mb-0"><i class="bi bi-journal-text text-secondary"></i> Historial de Facturas</h1>
        </div>
        @if (!User.IsInRole("Propietario") && !User.IsInRole("Veterinario"))
        {
            <a asp-page="./EmitirFactura" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Factura</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código Factura</th>
                            <th>Cliente</th>
                            <th>Evento</th>
                            <th>Subtotal</th>
                            <th>Total</th>
                            <th>Estado Pago</th>
                            <th>Fecha Emisión</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Facturas.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No se encontraron facturas registradas.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Facturas)
                            {
                                <tr>
                                    <td><strong>@item.CodigoFactura</strong></td>
                                    <td>@item.ClienteNombre</td>
                                    <td>@item.EventoNombre</td>
                                    <td>@item.Subtotal.ToString("C")</td>
                                    <td><strong>@item.Total.ToString("C")</strong></td>
                                    <td>
                                        <span class="badge @(item.EstadoPago == "Pagada" ? "bg-success" : (item.EstadoPago == "Pendiente" ? "bg-warning text-dark" : "bg-danger"))">@item.EstadoPago</span>
                                    </td>
                                    <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end px-4">
                                        <a asp-page="./Detalle" asp-route-id="@item.IdFactura" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Ver Detalle</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
