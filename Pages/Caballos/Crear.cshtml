@page
@model HipodromoNacional.Pages.Caballos.CrearModel
@{
    ViewData["Title"] = "Registrar Caballo";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-heptagon"></i> Registrar Nuevo Caballo</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Código Único</label>
                    <input asp-for="Caballo.CodigoUnico" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Caballo.Nombre" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="Caballo.FechaNacimiento" type="date" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Sexo</label>
                    <select asp-for="Caballo.Sexo" class="form-select" required>
                        <option value="Macho">Macho</option>
                        <option value="Hembra">Hembra</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ID Raza</label>
                    <input asp-for="Caballo.IdRaza" type="number" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Peso (Kg)</label>
                    <input asp-for="Caballo.PesoKg" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Estado de Salud</label>
                    <select asp-for="Caballo.EstadoSalud" class="form-select" required>
                        <option value="Saludable">Saludable</option>
                        <option value="EnTratamiento">EnTratamiento</option>
                        <option value="NoApto">NoApto</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ID Propietario</label>
                    <input asp-for="Caballo.IdPropietario" type="number" class="form-control" required />
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
