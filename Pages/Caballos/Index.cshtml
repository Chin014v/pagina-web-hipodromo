@page
@model HipodromoNacional.Pages.Caballos.IndexModel
@{
    ViewData["Title"] = "Listado de Caballos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-heptagon"></i> Caballos Registrados</h2>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Registrar Caballo</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Sexo</th>
                <th>Peso (kg)</th>
                <th>Estado Salud</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Caballos)
            {
                <tr>
                    <td>@c.CodigoUnico</td>
                    <td>@c.Nombre</td>
                    <td>@c.Sexo</td>
                    <td>@c.PesoKg</td>
                    <td>@(c.EstadoSalud == "EnTratamiento" ? "En Tratamiento" : c.EstadoSalud == "NoApto" ? "No Apto" : c.EstadoSalud)</td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@c.IdCaballo" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@c.IdCaballo" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
