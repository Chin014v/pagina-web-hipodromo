@page "{id:int}"
@model HipodromoNacional.Pages.Caballos.EditarModel
@{
    ViewData["Title"] = "Editar Caballo";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar un caballo</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

     
        <form method="post" novalidate>
            <input type="hidden" asp-for="Caballo.IdCaballo" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="Caballo.Nombre" class="form-control" required />
                <span asp-validation-for="Caballo.Nombre" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Peso (Kg)</label>
                <input asp-for="Caballo.PesoKg" type="number" step="0.01" min="0.1" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Caballo.PesoKg" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado de salud</label>
                <select asp-for="Caballo.EstadoSalud" class="form-select" required>
                    <option value="">Seleccione...</option>
                    <option value="Saludable">Saludable</option>
                    <option value="EnTratamiento">En Tratamiento</option>
                    <option value="NoApto">No Apto</option>
                </select>
                <span asp-validation-for="Caballo.EstadoSalud" class="field-validation-error"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}