@page "{id:int}"
@model HipodromoNacional.Pages.Caballos.EditarModel
@{
    ViewData["Title"] = "Editar Caballo";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Caballo</h4>
    </div>
    <div class="card-body">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="alert alert-info">
            Según las reglas del proyecto (Punto 7), modificaremos al menos 3 campos: <strong>Nombre, Peso y Estado de Salud</strong>.
        </div>

        <form method="post">
            <input type="hidden" asp-for="Caballo.IdCaballo" />

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="Caballo.Nombre" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Peso (Kg)</label>
                <input asp-for="Caballo.PesoKg" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Estado de Salud</label>
                <select asp-for="Caballo.EstadoSalud" class="form-select" required>
                    <option value="Saludable">Saludable</option>
                    <option value="EnTratamiento">EnTratamiento</option>
                    <option value="NoApto">NoApto</option>
                </select>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
