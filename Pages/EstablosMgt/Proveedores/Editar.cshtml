@page "{id:int}"
@model HipodromoNacional.Pages.EstablosMgt.Proveedores.EditarModel
@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Proveedor</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" novalidate>
            <input type="hidden" asp-for="Proveedor.IdProveedor" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select asp-for="Proveedor.Estado" class="form-select" required>
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                </select>
                <span asp-validation-for="Proveedor.Estado" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <input asp-for="Proveedor.Telefono" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input asp-for="Proveedor.Correo" type="email" class="form-control" />
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
