@page
@model HipodromoNacional.Pages.EstablosMgt.Proveedores.CrearModel
@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-truck"></i> Nuevo Proveedor</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Proveedor.Nombre" class="form-control" required />
                    <span asp-validation-for="Proveedor.Nombre" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Contacto</label>
                    <input asp-for="Proveedor.Contacto" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="Proveedor.Telefono" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Correo</label>
                    <input asp-for="Proveedor.Correo" type="email" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Estado</label>
                    <select asp-for="Proveedor.Estado" class="form-select" required>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                    <span asp-validation-for="Proveedor.Estado" class="field-validation-error"></span>
                </div>
            </div>
            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
