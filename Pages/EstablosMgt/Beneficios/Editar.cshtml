@page "{id:int}"
@model HipodromoNacional.Pages.EstablosMgt.Beneficios.EditarModel
@{
    ViewData["Title"] = "Editar Beneficio";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Beneficio</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" novalidate>
            <input type="hidden" asp-for="Beneficio.IdBeneficio" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">% Descuento</label>
                <input asp-for="Beneficio.PorcentajeDescuento" type="number" step="0.01" min="0" max="100" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Beneficio.PorcentajeDescuento" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select asp-for="Beneficio.Estado" class="form-select" required>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Aplicado">Aplicado</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
                <span asp-validation-for="Beneficio.Estado" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha de Aplicación</label>
                <input asp-for="Beneficio.FechaAplicacion" type="date" class="form-control" />
                <small class="text-muted">Dejar vacío si aún no se ha aplicado</small>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
