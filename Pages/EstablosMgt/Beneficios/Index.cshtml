@page
@model HipodromoNacional.Pages.EstablosMgt.Beneficios.IndexModel
@{
    ViewData["Title"] = "Beneficios Propietarios";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-gift"></i> Beneficios para Propietarios</h2>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Beneficio</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Propietario</th>
                <th>Tipo Beneficio</th>
                <th>% Descuento</th>
                <th>Fecha Asignación</th>
                <th>Fecha Aplicación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Beneficios)
            {
                <tr>
                    <td>@item.NombrePropietario</td>
                    <td>@item.TipoBeneficio</td>
                    <td>@item.PorcentajeDescuento.ToString("N2")%</td>
                    <td>@item.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                    <td>@(item.FechaAplicacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (item.Estado == "Activo")
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@item.IdBeneficio" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@item.IdBeneficio" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
