@page "{id:int}"
@model HipodromoNacional.Pages.EstablosMgt.Suministros.EditarModel
@{
    ViewData["Title"] = "Editar Suministro";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Suministro</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="alert alert-info">
            Según las reglas del proyecto (Punto 7), modificamos: <strong>Cantidad Disponible, Estado y Fecha de Ingreso</strong>.
        </div>

        <form method="post" novalidate>
            <input type="hidden" asp-for="Suministro.IdSuministro" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Cantidad Disponible</label>
                <input asp-for="Suministro.CantidadDisponible" type="number" step="0.01" min="0" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Suministro.CantidadDisponible" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Estado</label>
                <select asp-for="Suministro.Estado" class="form-select" required>
                    <option value="Disponible">Disponible</option>
                    <option value="Agotado">Agotado</option>
                </select>
                <span asp-validation-for="Suministro.Estado" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha de Ingreso</label>
                <input asp-for="Suministro.FechaIngreso" type="date" class="form-control" required />
                <span asp-validation-for="Suministro.FechaIngreso" class="field-validation-error"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
