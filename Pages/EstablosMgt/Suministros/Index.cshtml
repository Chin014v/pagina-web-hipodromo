@page
@model HipodromoNacional.Pages.EstablosMgt.Suministros.IndexModel
@{
    ViewData["Title"] = "Suministros";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/EstablosMgt/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-box"></i> Suministros</h2>
    </div>
    @if (User.IsInRole("EncargadoEstablo"))
    {
        <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Suministro</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Proveedor</th>
                <th>Cantidad</th>
                <th>Unidad</th>
                <th>Estado</th>
                @if (User.IsInRole("EncargadoEstablo"))
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Suministros)
            {
                <tr>
                    <td><code>@item.Codigo</code></td>
                    <td>@item.NombreSuministro</td>
                    <td>@item.Tipo</td>
                    <td>@item.NombreProveedor</td>
                    <td>@item.CantidadDisponible.ToString("N2")</td>
                    <td>@item.UnidadMedida</td>
                    <td>
                        @if (item.Estado == "Disponible")
                        {
                            <span class="badge bg-success">@item.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    @if (User.IsInRole("EncargadoEstablo"))
                    {
                        <td>
                            <a asp-page="./Editar" asp-route-id="@item.IdSuministro" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-page="./Eliminar" asp-route-id="@item.IdSuministro" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
