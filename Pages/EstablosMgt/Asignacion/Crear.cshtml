@page
@model HipodromoNacional.Pages.EstablosMgt.Asignacion.CrearModel
@{
    ViewData["Title"] = "Nueva Asignación de Establo";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-building"></i> Nueva Asignación de Establo</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Caballo</label>
                    <select asp-for="Asignacion.IdCaballo" class="form-select" required data-val-number="Ingrese un número válido.">
                        <option value="">Seleccione...</option>
                        @foreach (var c in Model.Caballos)
                        {
                            <option value="@c.IdCaballo">@c.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="Asignacion.IdCaballo" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Establo</label>
                    <select asp-for="Asignacion.IdEstablo" class="form-select" required data-val-number="Ingrese un número válido.">
                        <option value="">Seleccione...</option>
                        @foreach (var e in Model.Establos)
                        {
                            <option value="@e.IdEstablo">@e.Codigo - @e.Ubicacion</option>
                        }
                    </select>
                    <span asp-validation-for="Asignacion.IdEstablo" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha Asignación</label>
                    <input asp-for="Asignacion.FechaAsignacion" type="date" class="form-control" required />
                    <span asp-validation-for="Asignacion.FechaAsignacion" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Estado</label>
                    <select asp-for="Asignacion.Estado" class="form-select" required>
                        <option value="Activa">Activa</option>
                        <option value="Inactiva">Inactiva</option>
                    </select>
                    <span asp-validation-for="Asignacion.Estado" class="field-validation-error"></span>
                </div>
            </div>
            <hr />
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
