@page "{id:int}"
@model HipodromoNacional.Pages.EstablosMgt.Asignacion.EliminarModel
@{
    ViewData["Title"] = "Eliminar Asignación";
}

<div class="card shadow-sm mt-4 border-danger">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación</h4>
    </div>
    <div class="card-body text-center py-5">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-start">@TempData["ErrorMessage"]</div>
        }

        <h5 class="text-danger">¿Estás seguro que deseas eliminar esta asignación?</h5>
        <h3 class="mt-3">@Model.Asignacion.NombreCaballo</h3>
        <p class="text-muted">Establo: @Model.Asignacion.CodigoEstablo</p>

        <form method="post" class="mt-4">
            <input type="hidden" asp-for="Asignacion.IdAsignacion" />
            <button type="submit" class="btn btn-danger btn-lg"><i class="bi bi-trash"></i> Sí, Eliminar</button>
            <a asp-page="./Index" class="btn btn-secondary btn-lg ms-2">Cancelar</a>
        </form>
    </div>
</div>
