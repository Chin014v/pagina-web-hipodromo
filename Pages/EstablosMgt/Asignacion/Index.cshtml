@page
@model HipodromoNacional.Pages.EstablosMgt.Asignacion.IndexModel
@{
    ViewData["Title"] = "Asignación de Establos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/EstablosMgt/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-building"></i> Asignación de Establos</h2>
    </div>
    @if (User.IsInRole("EncargadoEstablo"))
    {
        <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Asignación</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Caballo</th>
                <th>Establo</th>
                <th>Fecha Asignación</th>
                <th>Fecha Salida</th>
                <th>Estado</th>
                @if (User.IsInRole("EncargadoEstablo"))
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Asignaciones)
            {
                <tr>
                    <td>@item.NombreCaballo</td>
                    <td><code>@item.CodigoEstablo</code></td>
                    <td>@item.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                    <td>@(item.FechaSalida?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (item.Estado == "Activa")
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    @if (User.IsInRole("EncargadoEstablo"))
                    {
                        <td>
                            <a asp-page="./Editar" asp-route-id="@item.IdAsignacion" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-page="./Eliminar" asp-route-id="@item.IdAsignacion" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
