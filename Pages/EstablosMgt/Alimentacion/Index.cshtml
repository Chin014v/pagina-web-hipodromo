@page
@model HipodromoNacional.Pages.EstablosMgt.Alimentacion.IndexModel
@{
    ViewData["Title"] = "Alimentación";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/EstablosMgt/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-basket"></i> Alimentación de Caballos</h2>
    </div>
    <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Registro</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Caballo</th>
                <th>Suministro</th>
                <th>Fecha</th>
                <th>Cantidad</th>
                <th>Unidad</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Alimentaciones)
            {
                <tr>
                    <td>@item.NombreCaballo</td>
                    <td>@item.NombreSuministro</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@item.Cantidad.ToString("N2")</td>
                    <td>@item.Unidad</td>
                    <td>@item.Observaciones</td>
                    <td>
                        <a asp-page="./Editar" asp-route-id="@item.IdAlimentacion" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Eliminar" asp-route-id="@item.IdAlimentacion" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
