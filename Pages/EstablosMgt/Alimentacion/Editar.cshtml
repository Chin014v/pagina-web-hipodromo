@page "{id:int}"
@model HipodromoNacional.Pages.EstablosMgt.Alimentacion.EditarModel
@{
    ViewData["Title"] = "Editar Alimentación";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Alimentación</h4>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="alert alert-info">
            Según las reglas del proyecto (Punto 7), modificamos: <strong>Cantidad, Observaciones y Fecha</strong>.
        </div>

        <form method="post" novalidate>
            <input type="hidden" asp-for="Alimentacion.IdAlimentacion" data-val-number="Ingrese un número válido." />

            <div class="mb-3">
                <label class="form-label">Cantidad</label>
                <input asp-for="Alimentacion.Cantidad" type="number" step="0.01" min="0" class="form-control" required data-val-number="Ingrese un número válido." />
                <span asp-validation-for="Alimentacion.Cantidad" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Observaciones</label>
                <textarea asp-for="Alimentacion.Observaciones" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha</label>
                <input asp-for="Alimentacion.Fecha" type="date" class="form-control" required data-val-date="Ingrese una fecha válida." />
                <span asp-validation-for="Alimentacion.Fecha" class="field-validation-error"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Actualizar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
