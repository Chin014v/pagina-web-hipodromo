@page
@model HipodromoNacional.Pages.EstablosMgt.IndexModel
@{
    ViewData["Title"] = "Gestión de Establos";
}

<div class="d-flex align-items-center mb-4">
    <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
    <h2 class="mb-0"><i class="bi bi-box-seam"></i> Gestión de Establos y Suministros</h2>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-body text-center py-4">
                <i class="bi bi-box text-primary display-3"></i>
                <h4 class="mt-3">Suministros</h4>
                <p class="text-muted">Inventario de alimentos, medicamentos y herramientas</p>
                <a asp-page="./Suministros/Index" class="btn btn-outline-primary">Gestionar</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body text-center py-4">
                <i class="bi bi-basket text-success display-3"></i>
                <h4 class="mt-3">Alimentación</h4>
                <p class="text-muted">Consumo diario de alimentación por caballo</p>
                <a asp-page="./Alimentacion/Index" class="btn btn-outline-success">Gestionar</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-info">
            <div class="card-body text-center py-4">
                <i class="bi bi-building text-info display-3"></i>
                <h4 class="mt-3">Asignación Establos</h4>
                <p class="text-muted">Asignación y control de ubicación de caballos</p>
                <a asp-page="./Asignacion/Index" class="btn btn-outline-info">Gestionar</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-body text-center py-4">
                <i class="bi bi-truck text-warning display-3"></i>
                <h4 class="mt-3">Proveedores</h4>
                <p class="text-muted">Registro y control de proveedores</p>
                <a asp-page="./Proveedores/Index" class="btn btn-outline-warning">Gestionar</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-danger">
            <div class="card-body text-center py-4">
                <i class="bi bi-gift text-danger display-3"></i>
                <h4 class="mt-3">Beneficios Propietarios</h4>
                <p class="text-muted">Descuentos y beneficios para propietarios frecuentes</p>
                <a asp-page="./Beneficios/Index" class="btn btn-outline-danger">Gestionar</a>
            </div>
        </div>
    </div>
</div>
