@page
@model HipodromoNacional.Pages.Razas.CrearModel
@{
    ViewData["Title"] = "Nueva Raza";
}

<div class="container px-4">
    <div class="my-4">
        <h1><i class="bi bi-plus-circle text-primary"></i> Nueva Raza</h1>
        <p class="text-muted">Ingresa los datos para registrar una nueva raza de caballos.</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Raza.NombreRaza">Nombre de la Raza</label>
                            <input class="form-control" asp-for="Raza.NombreRaza" placeholder="Ej. Pura Sangre" />
                            <span class="text-danger" asp-validation-for="Raza.NombreRaza"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Raza.Descripcion">Descripción</label>
                            <textarea class="form-control" asp-for="Raza.Descripcion" rows="3" placeholder="Descripción física o aptitudes de la raza..."></textarea>
                            <span class="text-danger" asp-validation-for="Raza.Descripcion"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Raza.Estado">Estado</label>
                            <select class="form-select" asp-for="Raza.Estado">
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                            <span class="text-danger" asp-validation-for="Raza.Estado"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Regresar</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar Raza</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
