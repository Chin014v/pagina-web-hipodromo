@page
@model HipodromoNacional.Pages.Razas.EliminarModel
@{
    ViewData["Title"] = "Eliminar Raza";
}

<div class="container px-4">
    <div class="my-4">
        <h1 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> ¿Eliminar Raza?</h1>
        <p class="text-muted">¿Está seguro de que desea eliminar la siguiente raza de caballos? Esta acción es irreversible.</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Raza.IdRaza" />

                        <table class="table table-borderless">
                            <tr>
                                <th>Nombre Raza:</th>
                                <td>@Model.Raza.NombreRaza</td>
                            </tr>
                            <tr>
                                <th>Descripción:</th>
                                <td>@Model.Raza.Descripcion</td>
                            </tr>
                            <tr>
                                <th>Estado:</th>
                                <td><span class="badge bg-secondary">@Model.Raza.Estado</span></td>
                            </tr>
                        </table>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar Definitivamente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
