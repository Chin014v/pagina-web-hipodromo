@page
@model HipodromoNacional.Pages.Razas.IndexModel
@{
    ViewData["Title"] = "Razas de Caballos";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h1><i class="bi bi-bookmark-fill text-warning"></i> Razas de Caballos</h1>
        <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Raza</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre Raza</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Razas.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No hay razas registradas.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Razas)
                            {
                                <tr>
                                    <td><strong>@item.NombreRaza</strong></td>
                                    <td>@item.Descripcion</td>
                                    <td>
                                        <span class="badge @(item.Estado == "Activo" ? "bg-success" : "bg-danger")">@item.Estado</span>
                                    </td>
                                    <td class="text-end px-4">
                                        <a asp-page="./Editar" asp-route-id="@item.IdRaza" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i> Editar</a>
                                        <a asp-page="./Eliminar" asp-route-id="@item.IdRaza" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
