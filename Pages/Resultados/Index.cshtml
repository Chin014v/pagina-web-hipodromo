@page
@model HipodromoNacional.Pages.Resultados.IndexModel
@{
    ViewData["Title"] = "Resultados de Carreras";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 p-5 rounded-4 bg-white">
                <div class="mb-4">
                    <span class="display-1 text-primary"><i class="bi bi-trophy"></i></span>
                </div>
                <h1 class="fw-bold mb-3">Módulo de Resultados de Carreras</h1>
                <p class="lead text-muted mb-4">
                    Este módulo está planificado para el registro de posiciones finales de llegada, tiempos de registro de los caballos participantes y la asignación automática de premios.
                </p>
                <div class="alert alert-warning border-warning-subtle rounded-3 d-inline-flex align-items-center justify-content-center px-4 py-3 mb-4 mx-auto" style="max-width: 500px;">
                    <i class="bi bi-gear-fill spin me-3 text-warning fs-3"></i>
                    <div class="text-start">
                        <strong class="text-warning-emphasis">Estado: Pendiente de Implementación</strong>
                        <div class="small text-muted">La interfaz de usuario y las llamadas a los procedimientos almacenados de premios se integrarán en la siguiente fase.</div>
                    </div>
                </div>
                <div>
                    <a asp-page="/Index" class="btn btn-primary btn-lg px-4"><i class="bi bi-house-door"></i> Volver al Inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .spin {
        display: inline-block;
        animation: spin 3s linear infinite;
    }
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>
