@page
@model HipodromoNacional.Pages.Resultados.IndexModel
@{
    ViewData["Title"] = "Resultados de Carreras";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-trophy"></i> Resultados de Carreras</h2>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-page="./Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Resultado</a>
    }
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" asp-page-handler="CalcularPremios" class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Calcular premios para evento:</label>
                </div>
                <div class="col-md-4">
                    <select name="idEvento" class="form-select" required>
                        <option value="">Seleccione evento...</option>
                        @foreach (var ev in Model.EventosFinalizados)
                        {
                            <option value="@ev.IdEvento">@ev.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-info"><i class="bi bi-calculator"></i> Calcular Premios</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card mb-4 bg-light">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-bold"><i class="bi bi-filter"></i> Filtrar por Evento:</label>
            </div>
            <div class="col-md-5">
                <select name="FiltrarEventoId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos los Eventos --</option>
                    @foreach (var ev in Model.TodosEventos)
                    {
                        if (ev.IdEvento == Model.FiltrarEventoId)
                        {
                            <option value="@ev.IdEvento" selected>@ev.Nombre</option>
                        }
                        else
                        {
                            <option value="@ev.IdEvento">@ev.Nombre</option>
                        }
                    }
                </select>
            </div>
            @if (Model.FiltrarEventoId.HasValue)
            {
                <div class="col-auto">
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle"></i> Limpiar Filtro</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Caballo</th>
                <th>Evento</th>
                <th>Posición</th>
                <th>Tiempo</th>
                <th>Premio</th>
                @if (User.IsInRole("Administrador"))
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Resultados)
            {
                <tr>
                    <td>@item.NombreCaballo</td>
                    <td>@item.NombreEvento</td>
                    <td><span class="badge bg-dark fs-6">@item.Posicion</span></td>
                    <td>@item.TiempoRegistro.ToString("HH:mm:ss.ff")</td>
                    <td>₡@item.PremioObtenido.ToString("N2", new System.Globalization.CultureInfo("es-CR"))</td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <td>
                            <a asp-page="./Editar" asp-route-id="@item.IdResultado" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-page="./Eliminar" asp-route-id="@item.IdResultado" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
