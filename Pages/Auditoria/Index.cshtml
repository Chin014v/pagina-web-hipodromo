@page
@model HipodromoNacional.Pages.Auditoria.IndexModel
@{
    ViewData["Title"] = "Bitácora de Auditoría";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <a asp-page="/Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Regresar</a>
        <h2 class="mb-0"><i class="bi bi-shield-lock"></i> Bitácora de Auditoría</h2>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Seleccione tabla:</label>
            </div>
            <div class="col-md-4">
                <select name="TablaSeleccionada" class="form-select">
                    <option value="">-- Seleccione --</option>
                    @foreach (var t in Model.Tablas)
                    {
                        if (t == Model.TablaSeleccionada)
                        {
                            <option value="@t" selected>@t</option>
                        }
                        else
                        {
                            <option value="@t">@t</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Consultar</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.TablaSeleccionada))
{
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>ID Registro</th>
                    <th>Acción</th>
                    <th>Usuario BD</th>
                    <th>Fecha</th>
                    <th>Datos Anteriores</th>
                    <th>Datos Nuevos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Registros)
                {
                    <tr>
                        <td>@item.IdBitacora</td>
                        <td>@item.IdRegistroAfectado</td>
                        <td>
                            @switch (item.Accion)
                            {
                                case "INSERT":
                                    <span class="badge bg-success">INSERT</span>
                                    break;
                                case "UPDATE":
                                    <span class="badge bg-warning text-dark">UPDATE</span>
                                    break;
                                case "DELETE":
                                    <span class="badge bg-danger">DELETE</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Accion</span>
                                    break;
                            }
                        </td>
                        <td><code>@item.UsuarioBd</code></td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><pre class="mb-0" style="max-height:150px;overflow:auto;font-size:0.7rem;white-space:pre;background:#f8f9fa;padding:8px;border-radius:4px;">@IndexModel.FormatearJson(@item.DatosAnteriores)</pre></td>
                        <td><pre class="mb-0" style="max-height:150px;overflow:auto;font-size:0.7rem;white-space:pre;background:#f8f9fa;padding:8px;border-radius:4px;">@IndexModel.FormatearJson(@item.DatosNuevos)</pre></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Registros.Any())
        {
            <p class="text-muted text-center py-3">No se encontraron registros de auditoría para esta tabla.</p>
        }
    </div>
}
